---
import Icon from './Icon.astro';
import type { Car } from '../lib/types';
import { formatKm, formatMoney } from '../lib/format';

interface Props {
  car: Car;
}

const { car } = Astro.props;
const title = `${car.brand} ${car.model}`;
---

<article
  class="car-card group"
  data-car-card
  data-car-id={car.id}
  data-brand={car.brand}
  data-location={car.location}
  data-price={car.price}
  data-year={car.year}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-neutral-200">
    <img
      src={car.image}
      alt={title}
      width="800"
      height="600"
      loading="lazy"
      class="size-full object-cover transition duration-700 group-hover:scale-105"
    />
    <div class="absolute left-4 top-4 flex gap-2">
      {car.featured && <span class="tag bg-black text-white">Destacado</span>}
      <span class="tag bg-white text-black">{car.location}</span>
    </div>
    <button
      type="button"
      class="absolute inset-x-4 bottom-4 flex translate-y-3 items-center justify-between bg-white px-5 py-4 text-sm font-bold opacity-0 shadow-lg transition duration-300 group-hover:translate-y-0 group-hover:opacity-100 focus-visible:translate-y-0 focus-visible:opacity-100"
      data-car-open
      aria-label={`Ver ${title}`}
    >
      Ver vehículo <Icon name="arrow" size={18} />
    </button>
  </div>
  <div class="border-x border-b border-black/10 p-5">
    <div class="text-[11px] font-bold uppercase tracking-[.17em] text-black/45">{car.brand}</div>
    <div class="mt-1 flex items-start justify-between gap-3">
      <h3 class="font-display text-2xl font-extrabold italic leading-none">
        <a href={`/vehiculo/${car.id}`} class="hover:underline">{car.model}</a>
      </h3>
      <div class="font-display whitespace-nowrap text-xl font-black italic">
        {formatMoney(car.price, car.currency)}
      </div>
    </div>
    <div class="mt-5 grid grid-cols-3 border-t border-black/10 pt-4 text-xs text-black/55">
      <div>
        <span class="mb-1 block text-black"><Icon name="clock" size={16} /></span>
        {car.year}
      </div>
      <div>
        <span class="mb-1 block text-black"><Icon name="gear" size={16} /></span>
        {car.transmission}
      </div>
      <div>
        <span class="mb-1 block text-black"><Icon name="car" size={16} /></span>
        {formatKm(car.km)} km
      </div>
    </div>
  </div>
</article>
