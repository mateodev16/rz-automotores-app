---
import Icon from './Icon.astro';
import type { Car } from '../lib/types';
import { WHATSAPP_LINK } from '../lib/config';

interface Props {
  cars: Car[];
}

const { cars } = Astro.props;
const payload = JSON.stringify(cars).replace(/</g, '\\u003c');
---

<div
  id="car-modal"
  class="car-modal fixed inset-0 z-50 items-end bg-black/70 p-0 backdrop-blur-sm md:items-center md:justify-center md:p-6"
  data-car-modal
  data-whatsapp={WHATSAPP_LINK}
>
  <div class="relative max-h-[94vh] w-full max-w-5xl overflow-auto bg-white" data-car-modal-panel>
    <button
      type="button"
      class="absolute right-4 top-4 z-10 grid size-11 place-items-center bg-white shadow"
      data-car-modal-close
      aria-label="Cerrar"
    >
      <Icon name="close" />
    </button>
    <div class="grid lg:grid-cols-[1.25fr_.75fr]">
      <div class="min-h-[340px] bg-neutral-100 lg:min-h-[620px]">
        <img data-car-modal-image src="" alt="" class="size-full object-cover" />
      </div>
      <div class="flex flex-col justify-between p-7 md:p-10">
        <div>
          <span class="tag bg-black text-white" data-car-modal-location></span>
          <div class="mt-8 text-xs font-bold uppercase tracking-[.2em] text-black/40" data-car-modal-brand></div>
          <h2 class="font-display mt-2 text-5xl font-black italic leading-none" data-car-modal-model></h2>
          <div class="font-display mt-5 text-3xl font-black italic" data-car-modal-price></div>
          <div class="mt-10 divide-y divide-black/10 border-y border-black/10" data-car-modal-specs></div>
        </div>
        <a
          class="btn-black mt-10 w-full justify-center"
          data-car-modal-whatsapp
          href="#"
          target="_blank"
          rel="noreferrer"
        >
          <Icon name="whatsapp" /> Consultar por WhatsApp
        </a>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="cars-data" set:html={payload}></script>

<script>
  const modal = document.querySelector('[data-car-modal]');
  const panel = document.querySelector('[data-car-modal-panel]');
  const image = document.querySelector('[data-car-modal-image]');
  const locationEl = document.querySelector('[data-car-modal-location]');
  const brandEl = document.querySelector('[data-car-modal-brand]');
  const modelEl = document.querySelector('[data-car-modal-model]');
  const priceEl = document.querySelector('[data-car-modal-price]');
  const specsEl = document.querySelector('[data-car-modal-specs]');
  const whatsappEl = document.querySelector('[data-car-modal-whatsapp]');

  const priceFormat = new Intl.NumberFormat('es-UY', { maximumFractionDigits: 0 });
  const kmFormat = new Intl.NumberFormat('es-UY', { maximumFractionDigits: 0 });

  let catalogue = [];
  try {
    catalogue = JSON.parse(document.getElementById('cars-data')?.textContent || '[]');
  } catch {
    catalogue = [];
  }

  const open = (car) => {
    if (!car || !modal) return;

    const title = `${car.brand} ${car.model}`;
    if (image) {
      image.setAttribute('src', car.image || '');
      image.setAttribute('alt', title);
    }
    if (locationEl) locationEl.textContent = car.location ?? '';
    if (brandEl) brandEl.textContent = car.brand ?? '';
    if (modelEl) modelEl.textContent = car.model ?? '';
    if (priceEl) {
      const symbol = car.currency === 'UYU' ? '$' : 'US$';
      priceEl.textContent = `${symbol} ${priceFormat.format(Math.round(Number(car.price) || 0))}`;
    }
    if (specsEl) {
      const rows = [
        ['AÃ±o', car.year],
        ['Kilometraje', `${kmFormat.format(Number(car.km) || 0)} km`],
        ['TransmisiÃ³n', car.transmission],
        ['Combustible', car.fuel],
      ];
      specsEl.innerHTML = rows
        .map(
          ([label, value]) =>
            `<div class="flex justify-between py-4 text-sm"><span class="text-black/45">${label}</span><strong>${value}</strong></div>`,
        )
        .join('');
    }
    if (whatsappEl) {
      const base = modal.getAttribute('data-whatsapp') || 'https://wa.me/59895530258';
      const text = `Hola, quiero consultar por el ${car.brand} ${car.model} ${car.year}.`;
      whatsappEl.setAttribute('href', `${base}?text=${encodeURIComponent(text)}`);
    }

    modal.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', onKeydown);
  };

  const close = () => {
    modal?.classList.remove('is-open');
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeydown);
  };

  const onKeydown = (event) => {
    if (event.key === 'Escape') close();
  };

  document.querySelectorAll('[data-car-open]').forEach((trigger) => {
    trigger.addEventListener('click', (event) => {
      event.preventDefault();
      const card = trigger.closest('[data-car-card]');
      const id = card?.getAttribute('data-car-id');
      open(catalogue.find((car) => String(car.id) === id));
    });
  });

  document.querySelector('[data-car-modal-close]')?.addEventListener('click', close);

  modal?.addEventListener('mousedown', (event) => {
    if (event.target === modal) close();
  });

  panel?.addEventListener('mousedown', (event) => event.stopPropagation());
</script>
