---
import Icon from './Icon.astro';
import { WHATSAPP_LINK } from '../lib/config';
---

<a
  href={WHATSAPP_LINK}
  target="_blank"
  rel="noreferrer"
  class="fixed bottom-5 right-5 z-30 grid size-14 place-items-center rounded-full bg-white text-black shadow-[0_8px_35px_rgba(0,0,0,.25)] transition hover:scale-105"
  aria-label="Contactar por WhatsApp"
>
  <Icon name="whatsapp" size={25} />
</a>
