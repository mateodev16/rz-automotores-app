---
import AdminLayout from '../../layouts/AdminLayout.astro';
import VehicleForm from '../../components/admin/VehicleForm.astro';
import Icon from '../../components/Icon.astro';
---

<AdminLayout title="Gestión de stock">
  <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
    <div>
      <div class="eyebrow">Inventario</div>
      <h1 class="font-display mt-2 text-4xl font-black italic md:text-5xl">Vehículos publicados</h1>
      <p class="mt-2 text-sm text-black/45">Agregá, revisá y eliminá vehículos del catálogo.</p>
    </div>
    <button type="button" id="toggle-form" class="btn-black shrink-0" aria-expanded="false" aria-controls="vehicle-form">
      <Icon name="plus" /> Agregar vehículo
    </button>
  </div>

  <div id="form-wrapper" class="mt-8 hidden">
    <VehicleForm formId="vehicle-form" mode="create" />
  </div>

  <div class="mt-8 border border-black/10 bg-white">
    <div class="flex flex-col justify-between gap-4 border-b border-black/10 p-5 md:flex-row md:items-center">
      <div>
        <strong class="text-sm">Todos los vehículos</strong>
        <span class="ml-2 text-xs text-black/40" id="car-count">—</span>
      </div>
      <label class="relative">
        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-black/35">
          <Icon name="search" size={17} />
        </span>
        <input
          id="car-search"
          type="search"
          placeholder="Buscar vehículo..."
          class="h-10 w-full border border-black/15 pl-10 pr-4 text-sm outline-none focus:border-black md:w-64"
        />
      </label>
    </div>

    <div class="divide-y divide-black/10" id="car-rows">
      <div class="p-12 text-center text-sm text-black/45" id="car-loading">Cargando vehículos…</div>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between text-xs text-black/35">
    <span id="admin-status">Panel conectado al servidor de RZ Automotores.</span>
    <button type="button" id="logout" class="underline underline-offset-4 hover:text-black">Cerrar sesión</button>
  </div>
</AdminLayout>

<script>
  import { adminFetch, imageUrl, logout, money, requireToken } from '../../lib/client';
  import type { Car } from '../../lib/types';

  if (requireToken()) {
    const rows = document.getElementById('car-rows');
    const loading = document.getElementById('car-loading');
    const countEl = document.getElementById('car-count');
    const sidebarCount = document.getElementById('sidebar-count');
    const search = document.getElementById('car-search');
    const toggle = document.getElementById('toggle-form');
    const wrapper = document.getElementById('form-wrapper');
    const status = document.getElementById('admin-status');

    let cars: Car[] = [];
    let query = '';

    const kmFormat = new Intl.NumberFormat('es-UY', { maximumFractionDigits: 0 });

    const render = () => {
      if (!rows) return;

      const filtered = cars.filter((car) =>
        `${car.brand} ${car.model} ${car.year}`.toLowerCase().includes(query.toLowerCase()),
      );

      rows.innerHTML = filtered.length
        ? filtered
            .map((car) => {
              const image = car.images?.[0] ?? car.image ?? '';
              const carStatus = car.status ?? 'published';
              const statusLabel = carStatus === 'published' ? 'Publicado' : carStatus === 'sold' ? 'Vendido' : 'Borrador';
              return `
                <div class="grid grid-cols-[76px_1fr_auto] items-center gap-4 p-4 md:grid-cols-[90px_1.4fr_.7fr_.7fr_auto] md:gap-6">
                  <img src="${imageUrl(image)}" alt="" class="h-16 w-full object-cover grayscale-[.25]" />
                  <div>
                    <strong class="block text-sm">${car.brand} ${car.model}</strong>
                    <span class="mt-1 block text-xs text-black/40">${car.year} · ${kmFormat.format(car.km || 0)} km · ${statusLabel}</span>
                  </div>
                  <div class="hidden text-sm font-bold md:block">${money(car.price, car.currency)}</div>
                  <div class="hidden md:block">
                    <span class="inline-flex bg-[#f1f1ef] px-3 py-1.5 text-xs">${car.location ?? ''}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <a href="/admin/autos/editar/${car.id}" class="grid size-10 place-items-center border border-black/10 transition hover:border-black" aria-label="Editar ${car.brand} ${car.model}">
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                    </a>
                    <button type="button" data-delete="${car.id}" class="grid size-10 place-items-center border border-black/10 text-black/45 transition hover:border-black hover:bg-black hover:text-white" aria-label="Eliminar ${car.brand} ${car.model}">
                      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14M10 11v6M14 11v6" /></svg>
                    </button>
                  </div>
                </div>`;
            })
            .join('')
        : '<div class="p-12 text-center text-sm text-black/45">No hay resultados.</div>';

      if (countEl) countEl.textContent = `${filtered.length} unidades`;
      if (sidebarCount) sidebarCount.textContent = String(cars.length);
    };

    const load = async () => {
      try {
        const data = await adminFetch<any[]>('/api/cars/admin/all');
        cars = (data ?? []).map((row) => ({
          id: String(row.id),
          brand: row.brand,
          model: row.model,
          year: Number(row.year),
          price: Number(row.price),
          km: Number(row.km ?? row.mileage ?? 0),
          transmission: row.transmission ?? 'Automática',
          fuel: row.fuel ?? 'Nafta',
          location: row.location ?? 'Montevideo',
          currency: row.currency ?? 'USD',
          image: row.images?.[0]?.url ?? '',
          images: (row.images ?? []).map((image: { url: string }) => image.url),
          featured: Boolean(row.featured),
          status: row.status ?? 'published',
          description: row.description ?? '',
          color: row.color ?? '',
        }));
        if (loading) loading.remove();
        if (status) status.textContent = 'Panel conectado al servidor de RZ Automotores.';
        render();
      } catch (error) {
        if (loading) loading.textContent = 'No se pudieron cargar los vehículos. Revisá la conexión con la API.';
        if (status) status.textContent = (error as Error)?.message ?? 'Error de conexión.';
      }
    };

    search?.addEventListener('input', () => {
      query = search.value;
      render();
    });

    toggle?.addEventListener('click', () => {
      const isHidden = wrapper?.classList.contains('hidden');
      wrapper?.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(Boolean(isHidden)));
      toggle.innerHTML = isHidden
        ? '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14" /></svg> Agregar vehículo'
        : '<svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18" /></svg> Cerrar formulario';
    });

    rows?.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const id = target?.closest('[data-delete]')?.getAttribute('data-delete');
      if (!id) return;
      if (!confirm('¿Eliminar este vehículo?')) return;
      try {
        await adminFetch(`/api/cars/${id}`, { method: 'DELETE' });
        await load();
      } catch (error) {
        alert((error as Error)?.message ?? 'No se pudo eliminar el vehículo.');
      }
    });

    document.getElementById('logout')?.addEventListener('click', logout);

    load();
  }
</script>
