PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/rz_automotores
JWT_SECRET=change_this_secret
UPLOAD_DIR=uploads
WHATSAPP_NUMBER=59895530258
ADMIN_EMAIL=admin@rzautomotores.com
ADMIN_PASSWORD=admin123

# --- Serverless (Vercel) ---
# Token de Vercel Blob. Si está presente, las imágenes se suben a Blob y se
# guarda la URL pública. Si no, se escriben en UPLOAD_DIR (sólo local).
BLOB_READ_WRITE_TOKEN=
# Orígenes permitidos por CORS. Vacío = se permiten todos.
CORS_ORIGIN=
# DB_SSL=true si tu Postgres exige TLS y no lo declara en la URL.
DB_SSL=
# Límites de subida (por defecto 4 archivos x 3 MB en Vercel).
MAX_IMAGES=
MAX_FILE_SIZE=
