{
  \"name\": \"rz-automotores-app\",
  \"private\": true,
  \"workspaces\": [
    \"apps/*\",
    \"packages/*\"
  ],
  \"scripts\": {
    \"dev\": \"concurrently \\\"npm run dev --workspace=apps/api\\\" \\\"npm run dev --workspace=apps/web\\\"\",
    \"dev:api\": \"npm run dev --workspace=apps/api\",
    \"dev:web\": \"npm run dev --workspace=apps/web\",
    \"build\": \"npm run build --workspace=apps/web && npm run build --workspace=apps/api\",
    \"start\": \"npm run start --workspace=apps/api\"
  },
  \"devDependencies\": {
    \"concurrently\": \"^8.2.2\"
  }
}
